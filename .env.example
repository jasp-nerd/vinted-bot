# You don't have to change anything in this file, ever.
# Searches, where alerts go, the Telegram bot, the dashboard password and phone access
# are all set up in the dashboard at http://localhost:8000 (or with the CLI), not here.
# Every line below is optional and shows its default. This file is for servers and
# Docker setups that want a value fixed in place.
# Full reference: docs/configuration.md

# --- Telegram -------------------------------------------------------------------------
# Normally pasted on the dashboard's Alerts page. Set here, it wins over that one and the
# dashboard shows it as set by the environment. A token from @BotFather: 123456:AAxxxx.
# VINTED_BOT_TELEGRAM_BOT_TOKEN=

# --- Web dashboard -------------------------------------------------------------------
# On by default at http://localhost:8000, no password. That is safe because only your
# own machine can reach it. The password is normally set in the dashboard's Settings
# (turning on phone access asks for one). Set here, it wins over that one: useful when
# the dashboard sits behind a reverse proxy. Generate one with: openssl rand -hex 32
# VINTED_BOT_WEB_AUTH_TOKEN=

# Set to false if you only use the CLI.
# VINTED_BOT_WEB_ENABLED=true

# Unset, the dashboard's "Allow my phone and other devices" switch decides: localhost
# only, or every interface. Set, it wins over the switch. The container sets 0.0.0.0
# internally; the compose file is what limits who can reach the published port.
# VINTED_BOT_WEB_HOST=127.0.0.1
# VINTED_BOT_WEB_PORT=8000

# The address the dashboard is reachable at from wherever you read your alerts — set it
# when the dashboard sits behind a reverse proxy or a tunnel. It becomes the Dashboard
# link in Discord messages; unset, that link points at http://<host>:<port> above.
# VINTED_BOT_WEB_PUBLIC_URL=

# Extra host names the dashboard answers to, comma-separated (e.g. finds.example.org). It
# always answers to localhost, any IP address, the host of WEB_PUBLIC_URL, one-word names
# and router/VPN names (.local, .lan, .home, .home.arpa, .internal, .fritz.box, .ts.net);
# other names are refused, which stops other websites using it through your browser (DNS
# rebinding). A public name here, or in WEB_PUBLIC_URL, also lets the internet in.
# VINTED_BOT_WEB_ALLOWED_HOSTS=

# Listening beyond this computer, the dashboard only serves this computer and private
# networks (home Wi-Fi, office LAN, Tailscale). Set to true to let the internet in too.
# Behind a reverse proxy that serves the internet, setting WEB_PUBLIC_URL to its public
# address does the same; a proxy that only serves your LAN needs nothing.
# VINTED_BOT_WEB_ALLOW_PUBLIC=false


# ======================================================================================
# Everything below is tuning. The defaults are deliberate; skip this on a first read.
# ======================================================================================

# --- How often to check --------------------------------------------------------------
# Seconds between checks for a new search. Per-search overrides live in the app itself.
# Below 10 is ignored: Vinted's own catalog lags further behind than that, so checking
# faster finds nothing sooner and does get you blocked.
# VINTED_BOT_POLL_DEFAULT_INTERVAL_S=60

# How old a listing may be and still count as new, in minutes. Listings the app can tell
# were already on Vinted longer ago are skipped, and after a gap in checking longer than
# this (the app off, the computer asleep) the first check records what it missed without
# announcing it, so a restart never replays yesterday's catalog.
# VINTED_BOT_FRESHNESS_WINDOW_MIN=20

# What a brand-new search does on its first check:
#   silent  notify nothing, just remember what is already there (default)
#   newest  send exactly one listing, so you can confirm delivery works
# VINTED_BOT_FIRST_RUN_MODE=silent


# --- Staying unblocked ---------------------------------------------------------------
# Start a fresh session after this many minutes. Blocks track how long a session has been
# alive more than how fast it is used, so replacing them on a timer helps.
# VINTED_BOT_SESSION_ROTATE_MINUTES=60

# Present a real browser's TLS fingerprint instead of Python's. Only worth turning on if
# you are getting blocked while the same search loads fine in your browser. Needs the
# image built with the 'impersonate' extra.
# VINTED_BOT_HTTP_IMPERSONATE=false

# A text file of proxy URLs, one per line. Off by default and rarely needed.
# VINTED_BOT_PROXY_FILE=

# How long to wait for Vinted before giving up on a single request.
# VINTED_BOT_REQUEST_TIMEOUT_S=15


# --- Noticing when something is wrong -------------------------------------------------
# How many checks with no new listing before a search is treated as stuck. It is only
# treated as stuck if other searches on the same site are still finding things.
# VINTED_BOT_WATCHDOG_STALE_CYCLES=10

# What to do about it: warn, or also start a fresh session (default).
# VINTED_BOT_WATCHDOG_ACTION=rotate

# Give up on an undelivered notification after this long. An alert about a listing from
# two hours ago is not worth sending.
# VINTED_BOT_OUTBOX_EXPIRY_MINUTES=60


# --- Where things are stored ----------------------------------------------------------
# Inside Docker this is already /data/app.db; leave it alone unless you know why.
# Unset outside Docker: ./data/app.db if that file already exists (so upgrades keep your
# searches), otherwise your user data folder, e.g. ~/.local/share/vinted-bot/app.db.
# VINTED_BOT_DB_PATH=./data/app.db

# Delete stored listings after this many days. Does not cause anything to be re-sent.
# VINTED_BOT_ITEM_RETENTION_DAYS=30

# Keep each listing's raw API payload. Useful when debugging, but it stores more seller
# data than notifications need, so it is off by default.
# VINTED_BOT_KEEP_RAW_JSON=false


# --- Time ------------------------------------------------------------------------------
# The time zone quiet hours and the stats page use. TZ is used if this is unset; the
# dashboard's settings page can change it later.
# VINTED_BOT_TIMEZONE=UTC


# --- Updating --------------------------------------------------------------------------
# Set by the installers' start-at-login entries (launchd, systemd or windows-launcher) to
# say something restarts the app after it exits, so updating from the dashboard can
# restart it too. Only set it for your own service if that service restarts after any exit.
# VINTED_BOT_SUPERVISED=


# --- Logging ---------------------------------------------------------------------------
# VINTED_BOT_LOG_LEVEL=INFO
# console while you are watching, json when something else is collecting it.
# VINTED_BOT_LOG_FORMAT=console


# --- Working on the code ----------------------------------------------------------------
# 'mock' replays recorded responses from disk instead of calling Vinted, so you can
# develop and demo offline. Requires a scenario directory.
# VINTED_BOT_FETCH_MODE=live
# VINTED_BOT_MOCK_SCENARIO_DIR=
